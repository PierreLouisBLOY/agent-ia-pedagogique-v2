  "deterministic_checks": [
    {
      "id": "A01",
      "code": "VERSION_BINDING",
      "rule": "Cible/production/version exactes ; sujet, correction, barème liés au même couple."
    },
    {
      "id": "A02",
      "code": "REQUIRED_STRUCTURE",
      "rule": "Cinq sections sujet exactes et bundle complet typé ; absence de bundle = FAIL."
    },
    {
      "id": "A03",
      "code": "QUESTION_IDENTITY",
      "rule": "IDs questions uniques et stables, dossier et locator valides ; aucune question omise/dupliquée."
    },
    {
      "id": "A04",
      "code": "CORRECTION_COVERAGE",
      "rule": "Une correction par question, aucun orphelin ; réponse et justification non vides."
    },
    {
      "id": "A05",
      "code": "MARKING_REFERENTIAL_INTEGRITY",
      "rule": "Une entrée par question et critères uniques ; aucune référence pendante."
    },
    {
      "id": "A06",
      "code": "TOTAL_TWENTY",
      "rule": "Points de critères = points question = points dossier ; somme exacte 20.00."
    },
    {
      "id": "A07",
      "code": "NUMERIC_DOMAIN",
      "rule": "Décimaux finis de précision bornée, unité EUR, points positifs ; pas de bool/float/NaN."
    },
    {
      "id": "A08",
      "code": "CASE_COMPONENT_TOTALS",
      "rule": "Ressources/emplois stables, actif/passif circulants et trésorerie : composants exhaustifs, totaux recalculés."
    },
    {
      "id": "A09",
      "code": "FRNG",
      "rule": "FRNG = ressources stables - emplois stables ; calcul exact au centime."
    },
    {
      "id": "A10",
      "code": "BFR",
      "rule": "BFR = actif circulant hors trésorerie - passif circulant hors trésorerie."
    },
    {
      "id": "A11",
      "code": "NET_TREASURY",
      "rule": "TN = FRNG - BFR = trésorerie active - trésorerie passive ; même scénario et même unité."
    },
    {
      "id": "A12",
      "code": "CONTEXT_PRESERVATION",
      "rule": "BTS CG, ASSESSMENT, 60 minutes, français et /20 ; somme des durées de dossiers = 60."
    },
    {
      "id": "A13",
      "code": "EVIDENCE_AND_PROVENANCE",
      "rule": "Refs exactes disponibles en session et allowlistées ; aucun label officiel/canonique ou validation inventé."
    },
    {
      "id": "A14",
      "code": "IMMUTABLE_TARGETED_DELTA",
      "rule": "V1 préservée ; seuls D3 et ses suppléments changent ; dépendances D1/D2 sans approbation explicite refusées."
    },
    {
      "id": "A15",
      "code": "ANSWER_CALCULATION_AND_LOCATORS",
      "rule": "Résultats numériques et expressions typées de la correction concordent avec les données/scénarios ; locators textuels exacts."
    },
    {
      "id": "A16",
      "code": "COVERAGE_LIMITS",
      "rule": "Couverture déclarée et limites : toute assertion hors calcul formalisé est WARNING, jamais validée pédagogiquement par CAP-A01."
    }
  ],
  "permissions": {
    "P_R3_IMPL": "APPROVED",
    "P_R3_DOC_NETWORK": "NOT_AUTHORIZED",
    "P_R3_LIVE_REVIEW": "NOT_AUTHORIZED",
    "P_R3_LIVE_MODIFY": "NOT_AUTHORIZED",
    "P_R3_LIVE_PREPARE_SUPPLEMENTS": "NOT_AUTHORIZED"
  },
  "status": "R3_SYNTHETIC_WIRING_ONLY",
  "currency_policy": "Explicit source EUR/kEUR label with exact subject locator; bounded decimal scale conversion to EUR; unknown or ambiguous scale rejected.",
  "review_policy": "Reports bind exact production, version and bundle hash. V2 is REVIEW_NOT_RUN until separately requested. CAP-A01 before atomic publication. No promotion.",
  "calculation_language": "Closed reference / ADD / SUB data AST; depth <=4, 2..16 operands per operator, <=60 calculations in the bundle; references resolved within one case, exact two-decimal results and answer locators. Free answer prose produces WARNING even when the output omits a limitation. Pedagogical judgment and rationales are never certified by CAP-A01.",
  "source_scale_contract": {
    "currency": "EUR",
    "source_scale": ["EUR", "kEUR"],
    "source_unit_locator": ["section_id", "start", "end", "exact_text"],
    "component": ["component_id", "source_value", "amount"],
    "normalization": "EUR factor 1; kEUR factor 1000; no heuristic, float or silent round-off."
  },
  "http": {
    "security": "Existing R2 loopback Host/Origin/nonce/intent and bounded framing are unchanged. GET never dispatches a provider.",
    "post_common_fields": ["conversation_id", "command_id", "expected_revision", "production_ref"],
    "assessment-preparations": ["version_ref", "subject_sha256"],
    "reviews": ["version_ref", "bundle_sha256", "dimensions"],
    "validations": ["version_ref", "bundle_sha256"],
    "modifications": ["base_version_ref", "base_bundle_sha256", "operation", "instruction"],
    "modification_operation": "HARDEN_DOSSIER_3",
    "modification_instruction": "Rends le dossier 3 plus difficile.",
    "job_states": ["RUNNING", "SUCCEEDED", "FAILED_NO_EFFECT", "FAILED_OUTPUT", "UNKNOWN"],
    "review_binding": ["production_ref", "version_ref", "subject_sha256", "bundle_sha256"],
    "response_contract": "REVIEW-MODIFY-HTTP-LOCAL-1.0",
    "security_and_framing_errors": "Existing CONVERSATION-HTTP-LOCAL-1.0 transport error envelope is preserved.",
    "generation_review_default": "R3_NOT_AUTHORIZED",
    "automatic_post_retry": false,
    "automatic_review_of_new_version": false
  },
  "limits": {
    "versions_per_production": 3,
    "reports_per_version": 8,
    "commands_per_session": 64,
    "job_seconds": 90
  },
  "allowed_test_exclusion": "tests/non_functional/test_retrieval_quality_real_gate.py",
  "real_seed_gate": "NOT_RUN / NOT_PASS"
